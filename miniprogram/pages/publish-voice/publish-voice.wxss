.publish {
  padding: 28rpx 24rpx 80rpx;
}

.tip {
  margin-bottom: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(217, 107, 84, 0.1);
  color: #8a4a3b;
  font-size: 26rpx;
  line-height: 1.5;
}

.stage {
  min-height: 520rpx;
  border-radius: 32rpx;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx;
}

.status {
  font-size: 34rpx;
  color: #7a5c50;
}

.duration {
  font-size: 56rpx;
  font-weight: 730;
  color: #c25540;
}

.rec {
  margin-top: 20rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #e07a62, #d96b54);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 36rpx rgba(217, 107, 84, 0.3);
  border: none;
}

.rec::after {
  border: none;
}

.rec.on {
  transform: scale(1.04);
  background: linear-gradient(145deg, #c25540, #a94435);
}

.preview {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
