<view class="page publish {{fontClass}}">
  <view class="tip">按住说话，松手结束。单条不超过 60 秒。家长只能听，不能录。</view>

  <view class="stage">
    <view class="status">{{statusText}}</view>
    <view class="duration">{{durationText}}</view>
    <button
      class="rec {{recording ? 'on' : ''}}"
      bindtouchstart="onStart"
      bindtouchend="onStop"
      bindtouchcancel="onStop"
    >{{recording ? '松手结束' : '按住录音'}}</button>
  </view>

  <view class="preview" wx:if="{{tempFilePath}}">
    <button class="btn-secondary" bindtap="onPreview">预听</button>
    <button class="btn-primary" loading="{{uploading}}" bindtap="onUpload">确认上传</button>
  </view>
</view>
