.timeline {
  padding-top: 12rpx;
}

.filters {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 28rpx 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #8a6b5e;
  font-size: 28rpx;
  border: 2rpx solid rgba(90, 55, 40, 0.06);
}

.filter.on {
  background: rgba(217, 107, 84, 0.14);
  color: #c25540;
  border-color: rgba(217, 107, 84, 0.25);
  font-weight: 650;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3b2a24;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8a6b5e;
  line-height: 1.6;
}

.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  min-width: 140rpx;
  height: 96rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #e07a62, #d96b54);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(217, 107, 84, 0.35);
  z-index: 20;
}
