.timeline {
  padding-top: 12rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.top-bar {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding-right: 20rpx;
}

.top-bar .filters {
  flex: 1;
}

.share-mini {
  margin: 8rpx 0 0;
  padding: 0 18rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 251, 247, 0.96);
  color: #c25540;
  font-size: 24rpx;
  font-weight: 700;
  border: 2rpx solid rgba(217, 107, 84, 0.18);
}

.share-mini::after {
  border: none;
}

.photo-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 16rpx 14rpx;
}

.photo-save,
.photo-del {
  color: #d96b54;
  font-size: 22rpx;
  font-weight: 600;
}

.photo-del {
  color: #a88878;
}

.stats-panel {
  margin: 0 28rpx 20rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
}

.range-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.range-label {
  color: #7a5c50;
  font-size: 26rpx;
}

.range-tabs {
  display: flex;
  gap: 10rpx;
}

.range {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #8a6b5e;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
}

.range.on {
  color: #c25540;
  background: rgba(217, 107, 84, 0.12);
  border-color: rgba(217, 107, 84, 0.25);
  font-weight: 650;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 0;
}

.s {
  width: 33.33%;
  text-align: center;
  padding: 10rpx 0;
}

.n {
  display: block;
  font-size: 34rpx;
  font-weight: 730;
  color: #c25540;
  line-height: 1.2;
}

.l {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a6b5e;
}

.stats-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9a7b6e;
  line-height: 1.4;
}

.filters {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 28rpx 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #8a6b5e;
  font-size: 28rpx;
  border: 2rpx solid rgba(90, 55, 40, 0.06);
}

.filter.on {
  background: rgba(217, 107, 84, 0.14);
  color: #c25540;
  border-color: rgba(217, 107, 84, 0.25);
  font-weight: 650;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3b2a24;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8a6b5e;
  line-height: 1.6;
}

.fab-mask {
  position: fixed;
  inset: 0;
  z-index: 19;
  background: rgba(40, 24, 18, 0.18);
}

.fab-wrap {
  position: fixed;
  right: 28rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
}

.fab-plus {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e07a62, #d96b54);
  color: #fff;
  font-size: 56rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(217, 107, 84, 0.35);
  transition: transform 220ms ease;
}

.fab-plus.open {
  transform: rotate(90deg);
}

.fab-menu {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  opacity: 0;
  transform: translateY(16rpx) scale(0.96);
  pointer-events: none;
  transition: opacity 220ms ease, transform 220ms ease;
}

.fab-menu.open {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.fab-item {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 251, 247, 0.96);
  color: #c25540;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(90, 55, 40, 0.14);
  border: 2rpx solid rgba(217, 107, 84, 0.18);
}

.photo-wall {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 28rpx 24rpx;
}

.photo-cell {
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
}

.photo-img {
  width: 100%;
  height: 280rpx;
  display: block;
}

.photo-meta {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx 0;
  font-size: 22rpx;
  color: #8a6b5e;
}

.photo-role {
  color: #d96b54;
  font-weight: 600;
}

.photo-caption {
  padding: 8rpx 16rpx 16rpx;
  font-size: 26rpx;
  color: #3b2a24;
  line-height: 1.45;
}
