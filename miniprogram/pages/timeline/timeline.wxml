<view class="page timeline {{demoMode ? 'page--demo' : ''}}">
  <view class="filters">
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="filter {{filter === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onFilter"
      >{{item.label}}</view>
  </view>

  <view class="stats-panel" wx:if="{{filter === 'transfer'}}">
    <view class="range-row">
      <text class="range-label">时间范围</text>
      <view class="range-tabs">
        <view class="range {{transferRange === 'year' ? 'on' : ''}}" data-range="year" bindtap="onRange">近一年</view>
        <view class="range {{transferRange === 'all' ? 'on' : ''}}" data-range="all" bindtap="onRange">全部</view>
      </view>
    </view>
    <view class="stats-grid">
      <view class="s">
        <text class="n">{{stats.incomeTotal}}</text>
        <text class="l">收到家长（元）</text>
      </view>
      <view class="s">
        <text class="n">{{stats.expenseTotal}}</text>
        <text class="l">我给家长（元）</text>
      </view>
      <view class="s">
        <text class="n">{{stats.incomeCount}}</text>
        <text class="l">收款笔数</text>
      </view>
      <view class="s">
        <text class="n">{{stats.incomeMax}}</text>
        <text class="l">单笔最大</text>
      </view>
      <view class="s">
        <text class="n">{{stats.incomeMin}}</text>
        <text class="l">单笔最小</text>
      </view>
      <view class="s">
        <text class="n">{{stats.incomeAvg}}</text>
        <text class="l">平均每笔</text>
      </view>
    </view>
    <view class="stats-note">数据来自真实转账凭证 + 后续新记的一笔，可持续更新。</view>
  </view>

  <block wx:if="{{filter === 'photo'}}">
    <view class="photo-wall" wx:if="{{photoList.length}}">
      <view
        class="photo-cell"
        wx:for="{{photoList}}"
        wx:key="_id"
      >
        <image
          class="photo-img"
          src="{{item.image}}"
          mode="aspectFill"
          data-src="{{item.image}}"
          bindtap="onPreviewPhoto"
          bindlongpress="onSavePhoto"
        />
        <view class="photo-meta">
          <text class="photo-role">{{item.roleLabel}}</text>
          <text class="photo-day">{{item.dayLabel}}</text>
        </view>
        <view class="photo-caption" wx:if="{{item.text}}">{{item.text}}</view>
        <view class="photo-save" data-src="{{item.image}}" bindtap="onSavePhoto">保存到相册</view>
      </view>
    </view>
    <view wx:else class="empty">
      <view class="empty-title">照片墙还是空的</view>
      <view class="empty-desc">妈妈或爸爸可以点右下角 + 上传照片。</view>
    </view>
  </block>

  <block wx:elif="{{list.length}}">
    <timeline-card
      wx:for="{{list}}"
      wx:key="_id"
      item="{{item}}"
      bind:react="onReact"
      bind:voiceplay="onVoicePlay"
      bind:voicepause="onVoiceEnd"
      bind:voiceended="onVoiceEnd"
    />
  </block>
  <view wx:elif="{{filter !== 'photo'}}" class="empty">
    <view class="empty-title">还没有留言</view>
    <view class="empty-desc">点右下角 + 号，发语音 / 记心意 / 写纸条。</view>
  </view>

  <view class="fab-wrap" wx:if="{{canPublish || canPublishPhoto}}">
    <view class="fab-menu {{fabOpen ? 'open' : ''}}">
      <view
        wx:if="{{canPublish}}"
        class="fab-item"
        data-url="/pages/publish-voice/publish-voice"
        bindtap="goPublish"
      >发语音</view>
      <view
        wx:if="{{canPublish}}"
        class="fab-item"
        data-url="/pages/publish-transfer/publish-transfer"
        bindtap="goPublish"
      >记心意</view>
      <view
        wx:if="{{canPublish}}"
        class="fab-item"
        data-url="/pages/publish-note/publish-note"
        bindtap="goPublish"
      >写纸条</view>
      <view
        wx:if="{{canPublishPhoto}}"
        class="fab-item"
        data-url="/pages/publish-photo/publish-photo"
        bindtap="goPublish"
      >传照片</view>
    </view>
    <view class="fab-plus {{fabOpen ? 'open' : ''}}" bindtap="toggleFab">{{fabOpen ? '×' : '+'}}</view>
  </view>
  <view class="fab-mask" wx:if="{{fabOpen}}" bindtap="toggleFab"></view>
</view>
