<view class="page timeline {{demoMode ? 'page--demo' : ''}} {{fontClass}}">
  <view class="filters">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter {{filter === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilter"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{list.length}}">
    <timeline-card
      wx:for="{{list}}"
      wx:key="_id"
      item="{{item}}"
      bind:react="onReact"
      bind:voiceplay="onVoicePlay"
      bind:voicepause="onVoiceEnd"
      bind:voiceended="onVoiceEnd"
    />
  </block>
  <view wx:else class="empty">
    <view class="empty-title">还没有留言</view>
    <view class="empty-desc">演示模式可以看到效果哦，去「我的」打开演示开关。</view>
  </view>

  <view class="fab" wx:if="{{canPublish}}" bindtap="goPublishMenu">记心意</view>
</view>
