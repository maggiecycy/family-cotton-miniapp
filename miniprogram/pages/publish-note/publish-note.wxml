<view class="page publish">
  <view class="form">
    <view class="label">想对家长说的话</view>
    <textarea
      maxlength="200"
      placeholder="写一句暖的，像塞进他们口袋的小纸条"
      value="{{text}}"
      bindinput="onInput"
      show-confirm-bar="{{false}}"
    />
    <view class="count">{{text.length}}/200</view>
  </view>
  <button class="btn-primary submit" loading="{{submitting}}" bindtap="onSubmit">放进时光轴</button>
</view>
