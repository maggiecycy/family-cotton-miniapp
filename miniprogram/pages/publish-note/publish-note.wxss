.publish {
  padding: 28rpx 24rpx 80rpx;
}

.form {
  border-radius: 28rpx;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
  padding: 28rpx;
}

.label {
  color: #7a5c50;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.images-label {
  margin-top: 24rpx;
}

textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 34rpx;
  line-height: 1.65;
  color: #3b2a24;
}

.count {
  margin-top: 12rpx;
  text-align: right;
  color: #8a6b5e;
  font-size: 24rpx;
}

.images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.img,
.add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
}

.img {
  background: #f0e4da;
}

.add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(217, 107, 84, 0.35);
  color: #c25540;
  font-size: 64rpx;
  background: rgba(255, 248, 242, 0.8);
}

.remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(60, 40, 30, 0.75);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit {
  margin-top: 36rpx;
}
