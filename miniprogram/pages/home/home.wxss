.home {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  height: 70vh;
  min-height: 860rpx;
  overflow: hidden;
  background: #f0d4c4;
}

.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 48%;
  background: linear-gradient(
    180deg,
    rgba(59, 42, 36, 0) 0%,
    rgba(59, 42, 36, 0.5) 55%,
    rgba(40, 24, 18, 0.78) 100%
  );
  pointer-events: none;
  z-index: 2;
}

.hero-copy {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 42rpx;
  z-index: 3;
  color: #fffaf6;
  transition: opacity 480ms ease-in-out, transform 480ms ease-in-out;
}

.hero-copy.text-out {
  opacity: 0;
  transform: translateY(16rpx);
}

.hero-copy.text-in {
  opacity: 1;
  transform: translateY(0);
}

.brand {
  font-size: 42rpx;
  font-weight: 760;
  letter-spacing: 1rpx;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28);
  margin-bottom: 14rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.chip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}

.chip.holiday {
  background: rgba(224, 163, 90, 0.42);
}

.chip.mood {
  background: rgba(217, 107, 84, 0.35);
}

.greet {
  font-size: 26rpx;
  line-height: 1.5;
  opacity: 0.96;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.28);
  min-height: 2.6em;
}

.chip.weather-demo {
  background: rgba(120, 120, 120, 0.45);
}

.chip.play {
  background: rgba(80, 180, 120, 0.45);
}

.hero-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.hero-btn {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #c25540;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-btn.ghost {
  background: rgba(255, 255, 255, 0.18);
  color: #fffaf6;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}

.font-larger .greet {
  font-size: 30rpx;
}

.panel {
  margin: -40rpx 24rpx 0;
  position: relative;
  z-index: 4;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
  box-shadow: 0 16rpx 40rpx rgba(90, 55, 40, 0.08);
}

.panel.rise-in {
  animation: riseIn 520ms ease both;
}

.stats {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 730;
  color: #c25540;
  line-height: 1.2;
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a6b5e;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.onboard-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  background: rgba(40, 24, 18, 0.52);
  display: flex;
  align-items: flex-end;
  padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.onboard-card {
  width: 100%;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 32rpx;
  background: #fffaf6;
  box-shadow: 0 24rpx 60rpx rgba(40, 24, 18, 0.22);
}

.onboard-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: rgba(217, 107, 84, 0.12);
  color: #c25540;
  font-size: 22rpx;
}

.onboard-title {
  font-size: 40rpx;
  font-weight: 730;
  color: #3b2a24;
  margin-bottom: 12rpx;
}

.onboard-desc {
  font-size: 28rpx;
  line-height: 1.55;
  color: #7a5c50;
}

.onboard-dots {
  display: flex;
  gap: 10rpx;
  margin: 28rpx 0 24rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(217, 107, 84, 0.2);
}

.dot.on {
  width: 28rpx;
  border-radius: 999rpx;
  background: #d96b54;
}

.onboard-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.onboard-skip {
  color: #9a7b6e;
  font-size: 28rpx;
  padding: 12rpx 8rpx;
}

.onboard-next {
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  background: #d96b54;
  color: #fffaf6;
  font-size: 28rpx;
  font-weight: 650;
}
