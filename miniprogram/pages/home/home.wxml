<view class="page home {{demoMode ? 'page--demo' : ''}} {{fontClass}}">
  <view class="hero">
    <avatar-girl
      expression="{{expression}}"
      speaking="{{speaking}}"
      show-hint="{{false}}"
      bind:play="onPlayGreet"
    />
    <view class="hero-shade"></view>
    <view class="hero-copy {{textAnim}}">
      <view class="brand">云端小棉袄-曹艳</view>
      <view class="chips">
        <view class="chip weather" wx:if="{{expression === 'idle' && weatherText}}">{{weatherText}}</view>
        <view
          class="chip weather-demo"
          wx:if="{{expression === 'idle' && (weatherSource === 'demo' || weatherSource === 'fallback')}}"
        >{{weatherSource === 'fallback' ? '云端假数据' : '演示'}}</view>
        <view class="chip holiday" wx:if="{{expression === 'idle' && holidayName}}">{{holidayName}}</view>
        <view class="chip mood">{{moodLabel}}</view>
        <view class="chip play" wx:if="{{speaking}}">播放中</view>
      </view>
      <view class="greet" bindtap="onPlayGreet">{{careLine}}</view>
      <view class="hero-actions">
        <view class="hero-btn ghost" bindtap="onNextMood">换表情</view>
      </view>
    </view>
  </view>

  <view class="panel rise-in">
    <view class="stats">
      <view class="stat">
        <text class="stat-num">{{companionDays}}</text>
        <text class="stat-label">已陪伴你（天）</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{voiceMonth}}</text>
        <text class="stat-label">本月语音</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{transferMonth}}</text>
        <text class="stat-label">本月心意</text>
      </view>
    </view>

    <view class="actions">
      <button class="btn-primary" bindtap="goListen">听女儿留言</button>
      <button class="btn-secondary" bindtap="goTransfers">看看家长的心意</button>
    </view>
  </view>
</view>

<view class="onboard-mask" wx:if="{{showOnboard}}" catchtouchmove="true">
  <view class="onboard-card">
    <view class="onboard-tag">第一次用？</view>
    <block wx:if="{{onboardStep === 0}}">
      <view class="onboard-title">听问候</view>
      <view class="onboard-desc">点照片或下方文字，就能听到女儿录好的问候。</view>
    </block>
    <block wx:elif="{{onboardStep === 1}}">
      <view class="onboard-title">换心情</view>
      <view class="onboard-desc">点「换表情」，看看不同心情下的照片和问候。</view>
    </block>
    <block wx:else>
      <view class="onboard-title">看留言</view>
      <view class="onboard-desc">底部「听女儿留言」进入时光轴，语音、心意、纸条都在这里。</view>
    </block>
    <view class="onboard-dots">
      <view class="dot {{onboardStep === 0 ? 'on' : ''}}"></view>
      <view class="dot {{onboardStep === 1 ? 'on' : ''}}"></view>
      <view class="dot {{onboardStep === 2 ? 'on' : ''}}"></view>
    </view>
    <view class="onboard-actions">
      <view class="onboard-skip" bindtap="onOnboardSkip">跳过</view>
      <view class="onboard-next" bindtap="onOnboardNext">{{onboardStep >= 2 ? '知道了' : '下一步'}}</view>
    </view>
  </view>
</view>
