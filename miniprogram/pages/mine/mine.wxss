.mine {
  padding: 28rpx 24rpx 60rpx;
}

.profile {
  padding: 36rpx 28rpx;
  border-radius: 32rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(255, 236, 220, 0.85)),
    #fff8f2;
  border: 2rpx solid rgba(90, 55, 40, 0.06);
  margin-bottom: 22rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 760;
  color: #3b2a24;
}

.role {
  margin-top: 10rpx;
  color: #c25540;
  font-size: 28rpx;
  font-weight: 600;
}

.desc {
  margin-top: 14rpx;
  color: #7a5c50;
  font-size: 28rpx;
  line-height: 1.6;
}

.group {
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 251, 247, 0.92);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
}

.row {
  min-height: 108rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid rgba(90, 55, 40, 0.05);
  font-size: 32rpx;
}

.row:last-child {
  border-bottom: none;
}

.value {
  color: #8a6b5e;
  font-size: 28rpx;
}

.invite-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
}

.invite-title {
  font-size: 34rpx;
  font-weight: 720;
  color: #3b2a24;
  margin-bottom: 10rpx;
}

.invite-desc {
  font-size: 26rpx;
  color: #7a5c50;
  line-height: 1.6;
  margin-bottom: 22rpx;
}

.invite-block {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(90, 55, 40, 0.06);
}

.invite-label {
  font-size: 26rpx;
  color: #8a6b5e;
  margin-bottom: 12rpx;
}

.invite-code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.invite-code {
  flex: 1;
  font-size: 40rpx;
  font-weight: 760;
  letter-spacing: 3rpx;
  color: #c25540;
}

.invite-btn {
  min-width: 120rpx;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #e07a62, #d96b54);
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.invite-btn.wide {
  width: 100%;
  margin-top: 16rpx;
  min-height: 88rpx;
}

.invite-btn.ghost {
  background: rgba(255, 255, 255, 0.92);
  color: #c25540;
  border: 2rpx solid rgba(217, 107, 84, 0.28);
  box-sizing: border-box;
}

.invite-card.soft {
  background: rgba(255, 248, 242, 0.96);
}

.invite-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9a7b6e;
  line-height: 1.45;
}

.share-btn {
  border: none;
  line-height: 88rpx;
}

.share-btn::after {
  border: none;
}

.bind-steps .step {
  font-size: 28rpx;
  color: #5d4a42;
  line-height: 1.7;
}

.about-title {
  padding: 28rpx 28rpx 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.about-body {
  padding: 8rpx 28rpx 20rpx;
  color: #7a5c50;
  font-size: 28rpx;
  line-height: 1.65;
}

.about-body.tech {
  color: #5d4a42;
}
