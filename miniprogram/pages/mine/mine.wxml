<view class="page mine {{demoMode ? 'page--demo' : ''}}">
  <view class="profile">
    <view class="title">云端小棉袄-曹艳</view>
    <view class="role">当前身份：{{roleText}}</view>
    <view class="desc">女儿发布留言；妈妈、爸爸都可以绑定进来观看、点「收到了」。</view>
  </view>

  <view class="group">
    <view class="row">
      <text>演示模式</text>
      <switch checked="{{demoMode}}" color="#D96B54" bindchange="onDemoChange" />
    </view>
    <view class="row" bindtap="onPickRole">
      <text>切换体验身份</text>
      <text class="value">{{roleText}} ›</text>
    </view>
    <view class="row" bindtap="onSetCity">
      <text>天气城市</text>
      <text class="value">{{weatherCity}} ›</text>
    </view>
    <view class="row" bindtap="onOpenSetting">
      <text>系统权限设置</text>
      <text class="value">麦克风/相册 ›</text>
    </view>
    <view class="row" bindtap="onResetUnread" wx:if="{{demoMode}}">
      <text>演示：制造未读角标</text>
      <text class="value">›</text>
    </view>
  </view>

  <!-- 女儿视角：发出邀请 -->
  <view class="invite-card" wx:if="{{isPublisher || demoMode}}">
    <view class="invite-title">发给爸妈</view>
    <view class="invite-desc">
      演示码 COTTON888 只在「演示模式」下可用。关演示后请先点「生成真实邀请码」，再发给爸妈。
    </view>
    <view class="invite-code-row">
      <text class="invite-code">{{inviteCode}}</text>
      <view class="invite-btn" bindtap="onInvite">复制</view>
    </view>
    <view class="invite-btn wide ghost" bindtap="onCreateInvite">生成真实邀请码</view>
    <button class="invite-btn wide share-btn" open-type="share">分享给家人</button>
    <view class="invite-tip">分享需微信认证通过后才可用；认证前请复制邀请码。</view>
  </view>

  <!-- 家长视角：加入家庭 -->
  <view class="invite-card soft" wx:if="{{!isPublisher || demoMode}}">
    <view class="invite-title">我是家长 · 加入家庭</view>
    <view class="invite-desc">
      收到女儿发来的邀请码后，点下面按钮，选「妈妈」或「爸爸」完成绑定。
    </view>
    <view class="invite-btn wide ghost" bindtap="onBind">输入邀请码绑定</view>
  </view>

  <view class="group">
    <view class="row" bindtap="go" data-url="/pages/festival/festival">
      <text>节日卡片</text>
      <text class="value">›</text>
    </view>
    <view class="row" bindtap="go" data-url="/pages/remind/remind">
      <text>日常提醒</text>
      <text class="value">›</text>
    </view>
  </view>

  <view class="group" wx:if="{{isPublisher}}">
    <view class="row" bindtap="go" data-url="/pages/publish-voice/publish-voice">
      <text>发语音</text>
      <text class="value">›</text>
    </view>
    <view class="row" bindtap="go" data-url="/pages/publish-transfer/publish-transfer">
      <text>记心意</text>
      <text class="value">›</text>
    </view>
    <view class="row" bindtap="go" data-url="/pages/publish-note/publish-note">
      <text>写纸条</text>
      <text class="value">›</text>
    </view>
  </view>

  <view class="group" wx:if="{{isParent || isPublisher}}">
    <view class="row" bindtap="go" data-url="/pages/publish-photo/publish-photo">
      <text>上传照片到照片墙</text>
      <text class="value">最多 9 张 ›</text>
    </view>
  </view>

  <view class="group">
    <view class="about-title">关于与隐私</view>
    <view class="about-body">
      给爸妈：这是女儿曹艳做的小程序。录音仅用于语音留言；相册/相机用于照片墙；保存到相册需你主动确认。详见项目文档 docs/PRIVACY.md，并请在公众平台同步配置用户隐私保护指引。
    </view>
  </view>
</view>
