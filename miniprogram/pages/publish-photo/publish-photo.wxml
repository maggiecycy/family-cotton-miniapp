<view class="page publish">
  <view class="form">
    <view class="label">选择照片（最多 {{maxCount}} 张）</view>
    <view class="grid">
      <view class="cell" wx:for="{{images}}" wx:key="*this">
        <image
          class="thumb"
          src="{{item}}"
          mode="aspectFill"
          data-src="{{item}}"
          bindtap="onPreview"
        />
        <view class="remove" data-index="{{index}}" catchtap="onRemove">×</view>
      </view>
      <view class="cell add" wx:if="{{images.length < maxCount}}" bindtap="onChoose">
        <text class="add-plus">+</text>
        <text class="add-hint">选照片</text>
      </view>
    </view>

    <view class="label caption-label">一句话（可选，写在第一张上）</view>
    <input
      maxlength="40"
      placeholder="例如：今天天气很好"
      value="{{caption}}"
      bindinput="onInput"
    />
  </view>
  <button class="btn-primary submit" loading="{{submitting}}" bindtap="onSubmit">
    放进照片墙{{images.length ? '（' + images.length + '）' : ''}}
  </button>
</view>
