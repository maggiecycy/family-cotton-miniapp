.publish {
  padding: 28rpx 24rpx 80rpx;
}

.form {
  border-radius: 28rpx;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
  padding: 28rpx;
}

.label {
  color: #7a5c50;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.caption-label {
  margin-top: 24rpx;
}

.photo-box {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx dashed rgba(217, 107, 84, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo {
  width: 100%;
  height: 100%;
}

.placeholder {
  color: #d96b54;
  font-size: 32rpx;
}

.change {
  margin-top: 12rpx;
  color: #7a5c50;
  font-size: 26rpx;
  text-align: center;
}

input {
  width: 100%;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #3b2a24;
}

.submit {
  margin-top: 28rpx;
}
