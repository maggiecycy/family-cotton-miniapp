.publish {
  padding: 28rpx 24rpx 80rpx;
}

.form {
  border-radius: 28rpx;
  background: rgba(255, 251, 247, 0.94);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
  padding: 28rpx;
}

.label {
  color: #7a5c50;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.caption-label {
  margin-top: 24rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(217, 107, 84, 0.12);
  box-sizing: border-box;
}

.thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.remove {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(59, 42, 36, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
  z-index: 2;
}

.cell.add {
  border-style: dashed;
  border-color: rgba(217, 107, 84, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-plus {
  color: #d96b54;
  font-size: 48rpx;
  line-height: 1;
}

.add-hint {
  margin-top: 8rpx;
  color: #d96b54;
  font-size: 24rpx;
}

input {
  width: 100%;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: #3b2a24;
}

.submit {
  margin-top: 28rpx;
}
