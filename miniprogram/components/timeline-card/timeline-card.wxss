.card {
  margin: 0 28rpx 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 251, 247, 0.92);
  border: 2rpx solid rgba(90, 55, 40, 0.06);
  box-shadow: 0 10rpx 30rpx rgba(90, 55, 40, 0.05);
  animation: rise 420ms ease both;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.tag--transfer,
.tag--in {
  background: rgba(224, 163, 90, 0.18);
  color: #b06a20;
}

.tag--out {
  background: rgba(217, 107, 84, 0.14);
  color: #c25540;
}

.direction {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #8a6b5e;
}

.note-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.note-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f0e4da;
}

.tag--voice {
  background: rgba(217, 107, 84, 0.14);
  color: #c25540;
}

.tag--note {
  background: rgba(120, 140, 170, 0.14);
  color: #4f6480;
}

.time {
  color: #8a6b5e;
  font-size: 24rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.currency {
  font-size: 34rpx;
  color: #c25540;
  font-weight: 700;
}

.amount {
  font-size: 64rpx;
  line-height: 1;
  font-weight: 730;
  color: #c25540;
  letter-spacing: 1rpx;
}

.category {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(224, 163, 90, 0.16);
  color: #9a6420;
  font-size: 22rpx;
}

.remark {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.message {
  margin-top: 14rpx;
  color: #7a5c50;
  font-size: 28rpx;
}

.note-text {
  font-size: 34rpx;
  line-height: 1.65;
  color: #3b2a24;
  white-space: pre-wrap;
}

.reactions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid rgba(90, 55, 40, 0.08);
  color: #7a5c50;
  font-size: 26rpx;
}

.chip.on {
  border-color: rgba(217, 107, 84, 0.35);
  background: rgba(217, 107, 84, 0.1);
  color: #c25540;
  font-weight: 600;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
