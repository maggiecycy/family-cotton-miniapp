<view class="avatar {{speaking ? 'is-speaking' : ''}}" bindtap="onTap" bindlongpress="onLongPress">
  <view class="orb orb-a"></view>
  <view class="orb orb-b"></view>
  <view class="orb orb-c"></view>

  <!-- idle 微动 loop 视频（<200KB），说话或非 idle 时切回静态图 -->
  <video
    wx:if="{{showIdleVideo}}"
    class="photo layer idle-video on-top"
    src="{{idleVideoSrc}}"
    autoplay
    loop
    muted
    show-center-play-btn="{{false}}"
    controls="{{false}}"
    object-fit="cover"
    enable-progress-gesture="{{false}}"
  />

  <!-- 双层叠化：始终两张图在，靠 opacity 交叉淡入 -->
  <image
    class="photo layer {{activeLayer === 'a' ? 'on-top' : ''}}"
    src="{{srcA}}"
    mode="aspectFill"
    style="opacity: {{opacityA}};"
  />
  <image
    class="photo layer {{activeLayer === 'b' ? 'on-top' : ''}}"
    src="{{srcB}}"
    mode="aspectFill"
    style="opacity: {{opacityB}};"
  />

  <view class="glow"></view>
  <view class="hint" wx:if="{{showHint}}">点我听问候录音</view>
</view>
