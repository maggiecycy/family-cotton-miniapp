.avatar {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 0;
}

.glow {
  position: absolute;
  inset: -10%;
  background:
    radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.35), transparent 42%),
    radial-gradient(circle at 30% 70%, rgba(255, 190, 150, 0.22), transparent 45%);
  pointer-events: none;
  z-index: 1;
}

.photo {
  width: 100%;
  height: 100%;
  display: block;
  transform: scale(1.01);
  transition: opacity 280ms ease, transform 320ms ease;
}

.photo.fade-out {
  opacity: 0.25;
  transform: scale(1.04);
}

.photo.fade-in {
  opacity: 1;
  transform: scale(1.01);
}

.avatar.is-speaking .photo {
  transform: scale(1.03);
}

.hint {
  position: absolute;
  left: 50%;
  bottom: 36rpx;
  transform: translateX(-50%);
  z-index: 2;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(40, 24, 18, 0.42);
  color: #fffaf5;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  backdrop-filter: blur(6px);
}
