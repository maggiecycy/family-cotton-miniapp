.avatar {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #efd2c2;
}

.orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 3;
  opacity: 0.5;
}

.orb-a {
  width: 120rpx;
  height: 120rpx;
  left: 10%;
  top: 18%;
  background: rgba(255, 255, 255, 0.35);
  animation: floatA 5.5s ease-in-out infinite;
}

.orb-b {
  width: 80rpx;
  height: 80rpx;
  right: 14%;
  top: 28%;
  background: rgba(255, 210, 170, 0.45);
  animation: floatB 7s ease-in-out infinite;
}

.orb-c {
  width: 56rpx;
  height: 56rpx;
  left: 28%;
  bottom: 30%;
  background: rgba(255, 255, 255, 0.28);
  animation: floatC 6.2s ease-in-out infinite;
}

.idle-video {
  z-index: 2;
}

.photo.layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  /* 丝滑关键：足够长 + ease-in-out，且不叠加 transform 动画抢控制权 */
  transition: opacity 700ms ease-in-out;
  will-change: opacity;
  transform: scale(1.03);
}

.photo.on-top {
  z-index: 2;
}

.photo.layer:not(.on-top) {
  z-index: 1;
}

.glow {
  position: absolute;
  inset: -8%;
  z-index: 4;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.2), transparent 42%),
    radial-gradient(circle at 20% 80%, rgba(255, 180, 140, 0.16), transparent 40%);
}

.avatar.is-speaking .photo.on-top {
  animation: speakPulse 1.15s ease-in-out infinite;
}

.hint {
  position: absolute;
  left: 50%;
  bottom: 36rpx;
  transform: translateX(-50%);
  z-index: 5;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(40, 24, 18, 0.42);
  color: #fffaf5;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

@keyframes speakPulse {
  0%,
  100% {
    transform: scale(1.03);
  }
  50% {
    transform: scale(1.06);
  }
}

@keyframes floatA {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(18rpx, -28rpx, 0);
  }
}

@keyframes floatB {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(-22rpx, 20rpx, 0);
  }
}

@keyframes floatC {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(12rpx, -16rpx, 0);
  }
}
